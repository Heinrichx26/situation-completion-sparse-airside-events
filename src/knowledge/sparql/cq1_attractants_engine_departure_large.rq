PREFIX awhso: <https://w3id.org/awhso#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# CQ1. Which observed (OSM) airside objects co-occur with large-animal +
# departure + engine-damage events at the same airport?
SELECT DISTINCT ?airportId ?attrClass ?osmName ?status ?provKind
WHERE {
  ?e a awhso:StrikeEvent ;
     awhso:hasSizeGuild awhso:SizeLarge ;
     awhso:inPhase awhso:PhaseDeparture ;
     awhso:strikesComponent awhso:CompEngine ;
     awhso:damaged true ;
     awhso:occursAtAirport ?airport .
  ?airport awhso:airportId ?airportId ;
           awhso:observedAttractant ?osm .
  ?osm rdfs:label ?attrClass .
  OPTIONAL { ?osm awhso:labelText ?osmName }
  OPTIONAL {
    ?airport awhso:hasSlot ?slot .
    ?slot awhso:slotFiller ?osm ;
          awhso:slotLayer "artifact" ;
          awhso:slotStatus ?status ;
          awhso:hasProvenance ?prov .
    ?prov awhso:provenanceKind ?provKind .
  }
}
ORDER BY ?airportId ?attrClass ?osmName
