PREFIX awhso: <https://w3id.org/awhso#>

CONSTRUCT {
  ?g a awhso:PlanEventDisagreement ;
     awhso:aboutSite ?site ;
     awhso:aboutAction ?act ;
     awhso:disagreementKind "control_documented_pathway_mismatch" .
}
WHERE {
  ?site awhso:documentsAction ?act .
  ?act a awhso:ControlAction .
  ?site awhso:localUnsupported ?act .
  ?site awhso:populatedEventLog true .
  BIND(IRI(CONCAT("https://w3id.org/awhso#gap_d2m_", STRAFTER(STR(?site), "#"), "_", STRAFTER(STR(?act), "#"))) AS ?g)
}
