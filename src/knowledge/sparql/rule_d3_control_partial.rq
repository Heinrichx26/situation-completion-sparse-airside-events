PREFIX awhso: <https://w3id.org/awhso#>

# D3-partial. Licensed control omitted from a site that documents other actions.
CONSTRUCT {
  ?g a awhso:PlanEventDisagreement ;
     awhso:aboutSite ?site ;
     awhso:aboutAction ?act ;
     awhso:disagreementKind "pathway_omitted_control_plan_incomplete" .
}
WHERE {
  { ?e awhso:occursAtAirport ?site } UNION { ?e awhso:occursAtOperator ?site }
  ?e awhso:supportsAction ?act .
  FILTER NOT EXISTS { ?act awhso:preconditionAttractant ?c . }
  FILTER NOT EXISTS { ?site awhso:documentsAction ?act . }
  FILTER EXISTS { ?site awhso:documentsAction ?other . FILTER (?other != ?act) }
  BIND(IRI(CONCAT("https://w3id.org/awhso#gap_d3cp_", STRAFTER(STR(?site), "#"), "_", STRAFTER(STR(?act), "#"))) AS ?g)
}
