PREFIX awhso: <https://w3id.org/awhso#>

# D3-object. Local pathway licenses a habitat action; attractant observed; plan omits the action.
CONSTRUCT {
  ?g a awhso:PlanEventDisagreement ;
     awhso:aboutSite ?site ;
     awhso:aboutAction ?act ;
     awhso:disagreementKind "pathway_omitted_attractant_present" .
}
WHERE {
  { ?e awhso:occursAtAirport ?site } UNION { ?e awhso:occursAtOperator ?site }
  ?e awhso:supportsAction ?act .
  ?act awhso:preconditionAttractant ?clsInd .
  ?clsInd a ?attrClass .
  ?site awhso:observedAttractant ?obj .
  ?obj a ?attrClass .
  FILTER NOT EXISTS { ?site awhso:documentsAction ?act . }
  BIND(IRI(CONCAT("https://w3id.org/awhso#gap_d3p_", STRAFTER(STR(?site), "#"), "_", STRAFTER(STR(?act), "#"))) AS ?g)
}
